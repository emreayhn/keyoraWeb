// Cloudflare Workers: public/ statik site olarak yayınlanır; güvenlik başlıkları public/_headers dosyasından gelir.
// Tek istisna: videolar (/assets/media/*) worker/range.js üzerinden, parça parça (Range) verilebilsin diye.
{
  "name": "keyoraweb",
  "compatibility_date": "2026-10-15",
  "main": "worker/range.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/media/*"]
  }
}
